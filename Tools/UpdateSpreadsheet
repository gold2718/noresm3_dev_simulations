_SHEET_FONT_SIZE=10

## Array of columns to fill
"""
Experiment ID
Compset
Resolution
Start year
End year
High freq output years (#)
Coupler history output (start / end)?
Initial / branch / hybrid
ref case start year for hybrid
"""
_COMPSET_TIMES = ['1850', '2000', '2010', 'hist']

_EXPERIMENT_COLUMNS = {"Issue_id":None, "Compset":None, "Resolution":None,
                       "Originator":None, "Start year":None,
                       "End year":None, "Model tag":None, "Computer":None,
                       "Exp. Type":None, "Refcase":None, "Refdate":None}
_COLUMN_WIDTHS = {"Issue_id":"10", "Compset":"15", "Resolution":"20",
                  "Originator":"20", "Start year":"15",
                  "End year":"15", "Model tag":"20", "Computer":"13",
                  "Exp. Type":"15", "Refcase":"20", "Refdate":"15"}
_COL_PREF_ORDER = ["Issue_id", "Compset", "Resolution", "Originator",
                   "Start year", "End year", "Model tag", "Exp. Type",
                   "Refcase", "Refdate"]

_BDICT_REGEXES = {}
_BDICT_REGEXES["Start year"] = re.compile(r"[*]*Start year[:][* ]*(.*[^ ])[ ]*$")
_BDICT_REGEXES["End year"] = re.compile(r"[*]*End year[:][* ]*(.*[^ ])[ ]*$")
_BDICT_REGEXES["Computer"] = re.compile(r"--mach(ine)?[ ]*([A-Za-z0-9_]+)")
_BDICT_REGEXES["Exp. Type"] = re.compile(r"xmlchange[ ]*RUN_TYPE=(.*)")
_BDICT_REGEXES["Refcase"] = re.compile(r"xmlchange[ ]*RUN_REFCASE=(.*)")
_BDICT_REGEXES["Refdate"] = re.compile(r"xmlchange[ ]*RUN_REFDATE=(.*)")
_BDICT_REGEXES["STOP_OPTION"] = re.compile(r"xmlchange[ ]*STOP_OPTION=(.*)")
_BDICT_REGEXES["STOP_N"] = re.compile(r"xmlchange[ ]*STOP_N=(.*)")
_BDICT_REGEXES["RESUBMIT"] = re.compile(r"xmlchange[ ]*RESUBMIT=(.*)")

def get_password(prompt=None):
    """
    Query the user (command line) for a password
    :param prompt: Optionally provide a prompt for the type of password
    :return: entered password or None on error
    """
    return getpass.getpass(prompt=prompt)

def is_exp_issue(title):
    """
    Given an issue title, try to determine if it looks like an experiment issue.
    """
    istitle = False
    title = title.lower()
    if isinstance(title, str):
        if (title[0:2] == 'nf') and (title[2:6] in _COMPSET_TIMES):
            istitle = True
        elif (title[0:1] == 'n') and (title[1:5] in _COMPSET_TIMES):
            istitle = True
        # end if
    # end if
    return istitle

def find_github_line_end(line, line_start, line_len):
    """
    Find and return the 'end' of a GitHub issues body line
       beginning at <line_start>.
    GitHub seems to use a line-feed character instead of a newline, at
       least in markdown mode.
    """
    lf = chr(10) # line feed
    cr = chr(13) # carriage return
    line_end = -1
    while line_end < 0:
        if (line[line_start] == lf) or (line[line_start] == cr):
            line_end = line_start
        else:
            line_start += 1
            if line_start >= line_len:
                line_end = line_len
            # end if
        # end if
    # end while
    return line_end

def find_body_info(body_text, body_dict):
    """
    Search <body_text> for items in <body_dict>.
    If found, the appropriate key in <body_dict> is updated
    Leading and trailing whitespace is disregarded.
    """

    bvalue = None
    line_start = 0
    line_end = 0
    line_len = len(body_text)
    while line_end < line_len:
        line_end = find_github_line_end(body_text, line_start, line_len)
        line = body_text[line_start:line_end]
        for key in _BDICT_REGEXES.keys():
            match = _BDICT_REGEXES[key].search(line.strip())
            if match:
                bvalue = match.group(len(match.groups()))
                body_dict[key] = bvalue
                exit
            # end if
        # end if
        line_start = line_end + 1
        line_end = line_start
    # end for

def download_github_issues(repo_name, PAT=None, issues_path=None,
                           repo_site="api.github.com/repos", user=None,
                           org="NorESMhub", protocol="https"):
    """
    Download all issues from a GitHub repository
    :param repo_name: the name of the repository (e.g., 'NorESM').
    :param token: a GitHub Personal Access Token (create on GitHub.com)
    :param issues_path: a destination filename for the repository's issues
                        (if provided)
    :param repo_site: Web location of repository
    :param user: Owner of 'PAT' (for accessing repository
    :param org: Organization or user within repository site
    :param protocol: protocol for reading repository (https or ssh)
    :return: Issues dictionary on success, None otherwise
    Inspired by https://stackoverflow.com/questions/57211865/downloading-issues-from-a-public-github-repository#57213375
    """
    assert isinstance(repo_name, str), "repository name must be a string"
    if not user:
        user = input("Enter the username for this access request: ").strip()
        assert isinstance(user, str), f"username must be a string, not {type(user)}"
    # end if
    if not PAT:
        PAT = get_password(f"Enter the access token for {repo_name}: ")
        assert isinstance(PAT, str), "access token must be a string"
    # end if
    if protocol == "https":
        repo_url = f"https://{repo_site}/{org}/{repo_name}"
    elif protocol == "ssh":
        repo_url = f"git@{repo_site}:{org}/{repo_name}"
    else:
        raise ValueError(f"Invalid protocol ({protocol}), enter https or ssh")
    # end if
    auth = github.Auth.Login(login=user, password=PAT)
    gh_access = github.Github(auth=auth)
    gh_org = gh_access.get_organization(org)
    repo = gh_org.get_repo(repo_name)
    issue_dict = {}
    issues = repo.get_issues(state="all")
    for issue in issues:
        number = None
        title = None
        compset = None
        code_vers = None
        start_year = None
        end_year = None
        body_dict = {"Start year":None, "End year":None, "Computer":None,
                     "Exp. Type":None, "Refcase":None, "Refdate":None}
        if isinstance(issue._pull_request, github.GithubObject._NotSetType):
            title = issue.title
            number = issue.number
            body = issue.body
            find_body_info(body, body_dict)
            user = issue.user.login
            args = title.split('.')
            if len(args) == 5:
                compset, grid, code_vers, info, date = args
            elif is_exp_issue(title):
                print(f"The title for issue {number} is not properly formatted")
            # end if (no else, just ignore non-experiment issues)
        # end if (no else, just ignore pull requests)
        if number and title and compset:
            if not start_year:
                period = compset[-4:]
                if period.lower() == 'hist':
                    start_year = 1850
                else:
                    try:
                        iyear = int(period)
                        start_year = 1
                    except ValueError as verr:
                        pass # We did not find a start year
                    # end try
                # end if
                body_dict["Start year"] = start_year
            # end if
            if start_year and (not end_year):
                nyears = None
                if ("STOP_OPTION" in body_dict) and ("STOP_N" in body_dict):
                    if "year" in body_dict["STOP_OPTION"]:
                        try:
                            nyears = int(body_dict["STOP_N"])
                        except ValueError as verr:
                            eval = body_dict["STOP_N"]
                            emsg = f"Invalid STOP_N, {eval}, in issue {number}"
                            raise ValueError(emsg) from verr
                        # end if
                    elif "month" in body_dict["STOP_OPTION"]:
                        try:
                            nyears = int(body_dict["STOP_N"]) / 12
                        except ValueError as verr:
                            eval = body_dict["STOP_N"]
                            emsg = f"Invalid STOP_N, {eval}, in issue {number}"
                            raise ValueError(emsg) from verr
                        # end try
                    else:
                        nyears = 0
                    # end if
                    if "RESUBMIT" in body_dict:
                        try:
                            nresub = int(body_dict["RESUBMIT"])
                            nyears = nyears * nresub
                        except ValueError as verr:
                            eval = body_dict["RESUBMIT"]
                            emsg = f"Invalid RESUBMIT, {eval}, in issue {number}"
                            raise ValueError(emsg) from verr
                        # end try
                    # end if
                    end_year = start_year + nyears
                    body_dict["End year"] = end_year
                # end if
            # end if
            # Clean up body_dict
            exp_keys = list(_EXPERIMENT_COLUMNS.keys())
            remove_keys = []
            for key in body_dict.keys():
                if key not in exp_keys:
                    remove_keys.append(key)
                # end if
            # end for
            for key in remove_keys:
                del body_dict[key]
            # end for

            issue_dict[number] = {"Issue_id":number, "Compset":compset,
                                  "Resolution":grid, "Model tag":code_vers,
                                  "Originator":user}
            issue_dict[number].update(body_dict)
        # end if
    # end for
    return issue_dict

def parse_command_line(args):
    """
    Parse the command line arguments.
    :param args: command line argument array
    :return: multiple arguments.
    """
    ap_format = argparse.RawTextHelpFormatter
    description="""Download and parse issues from a NorESM GitHub simulations
    repository and use the information to update an Excel spreadsheet.
    """
    ss_help = """Path to a Excel spreadsheet to create or modify.
    If the file does not exist, create a new spreadsheet to fill.
    If the file does exist, modify / update its contents with information from
    the issues repository or overwrite the whole file if the --overwrite
    flag is used."""
    ow_help = """Force a new spreadsheet to be created, even if the
    destination file already exists."""
    parser = argparse.ArgumentParser(description=description,
                                     formatter_class=ap_format)
    parser.add_argument("repository", metavar='<NorESM GitHub repository name>',
                        type=str,
                        help="Name of a NorESMhub GitHub simulation repository")
    parser.add_argument("spreadsheet", metavar='<path to Excel spreadsheet>',
                        type=str,
                        help=ss_help)
    parser.add_argument("--overwrite", action='store_true', help=ow_help)
    pargs = parser.parse_args(args)
    return pargs.repository, pargs.spreadsheet, pargs.overwrite

