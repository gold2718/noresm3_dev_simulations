def find_row(sheet, search_txt, min_row=None, min_col=None, max_col=None,
             blank_ok=True):
    """Given some text, search a column or columns for the
    first matching row.
    If blank_ok is True, return the first blank row if no matching row found.
    """
    assert isinstance(search_txt, str), "search_txt must be a string"
    search_row = None
    blank_row = None
    if min_row:
        row = min_row
    else:
        row = 1
    # end if
    if not min_col:
        min_col = 1
    # end if
    if not max_col:
        max_col = sheet.max_column
    # end if
    while (not search_row) and (row <= sheet.max_row):
        col = 1
        is_blank_row = True
        while col <= max_col:
            cell_val = str(sheet.cell(row=row, column=col).value)
            if cell_val == search_txt:
                search_row = row
                break
            elif cell_val:
                is_blank_row = False
            # end if
            col += 1
        # end while
        if is_blank_row and blank_ok and (blank_row is None):
            blank_row = row
        # end if
        row += 1
    # end while
    if (not search_row) and blank_ok:
        search_row = blank_row
    # end if
    return search_row

def set_cell(sheet, row, col, cell_text, alignment=None,
             fill=None, font=None, width=None, height=None):
    """
    Fill out and format a cell.
    """
    cell = sheet.cell(row=row, column=col)
    # Fixed border
    color = openpyxl.styles.colors.Color(rgb="000000")
    side = openpyxl.styles.borders.Side(color=color, border_style="thin")
    border = openpyxl.styles.borders.Border(left=side, right=side,
                                            bottom=side, top=side)
    cell.value = cell_text
    if alignment:
        cell.alignment = alignment
    # end if
    if font:
        cell.font = font
    # end if
    if fill:
        cell.fill = fill
    # end if
    if width:
        col_name = chr(ord('A') + col - 1)
        sheet.column_dimensions[col_name].width = width
    # end if
    if height:
        sheet.row_dimensions[row].height = height
    # end if
    # Restore the cell's border
    cell.border = border

def initialize_experiment_sheet(sheet):
    """
    Initialize a new spreadsheet by clearing any data and
    writing and formatting header fields.
    Return the title row number, first column number and last column number.
    """
    row = 1
    col = 1
    first_col = 1
    last_col = -1
    title_col = -1
    # Some sheet style information
    hcenter_align = openpyxl.styles.Alignment(horizontal="center")
    center_align = openpyxl.styles.Alignment(horizontal="center",
                                             vertical="center")
    title_font = openpyxl.styles.Font(size=str(_SHEET_FONT_SIZE + 6), bold=True)
    headers_font = openpyxl.styles.Font(size=str(_SHEET_FONT_SIZE + 4),
                                        bold=True)
    headers_fill = openpyxl.styles.fills.PatternFill(start_color="ddd9c3",
                                                     end_color="ddd9c3",
                                                     patternType="solid")
    title_row_height = "20"
    # Set the sheet title
    sheet.title = _EXP_SHEET
    # Write any header rows
    title = "Overview of coordinated Earth system experiments for NorESM3"
    set_cell(sheet, row, col, title, alignment=center_align, font=title_font,
             height="28")
    sheet.merge_cells(start_row=row, end_row=row,
                      start_column=1, end_column=len(_EXPERIMENT_COLUMNS))
    row += 1
    title_row = row
    for title in _COL_PREF_ORDER:
        # Write the prefered columns first
        set_cell(sheet, title_row, col, title, alignment=hcenter_align,
                 fill=headers_fill, font=headers_font,
                 width=_COLUMN_WIDTHS[title], height=title_row_height)
        _EXPERIMENT_COLUMNS[title] = col
        last_col = col
        col += 1
    # end for
    for title in _EXPERIMENT_COLUMNS.keys():
        # Now, write any leftover columns
        if title not in _COL_PREF_ORDER:
            set_cell(sheet, title_row, col, title, alignment=hcenter_align,
                     fill=headers_fill, font=headers_font,
                     width=_COLUMN_WIDTHS[title], height=title_row_height)
            _EXPERIMENT_COLUMNS[title] = col
            last_col = col
            col += 1
        # end if
    # end for
    return title_row, first_col, last_col

def find_experiment_row(sheet):
    """
    For an existing spreadsheet, find the title row and the column number
    for each experiment column.
    Return the title row number, first column number and last column number.
    """
    # Find the title row
    title_row = -1
    first_col = -1
    last_col = -1
    row = 1
    col = 1
    title_keys = list(_EXPERIMENT_COLUMNS.keys())
    while (title_row < 0) or (col > 1):
        title = sheet.cell(row=row, column=col).value
        if title:
            if title in title_keys:
                title_row = row
                _EXPERIMENT_COLUMNS[title] = col
                if first_col < 0:
                    first_col = col
                # end if
                last_col = col
            # end if
            col += 1
        else:
            # Title rows are not allowed to have blank entries
            row += 1
            col = 1
        # end if
        if col > sheet.max_column:
            row += 1
            col = 1
        # end if
    # end while
    if None in _EXPERIMENT_COLUMNS.values():
        missing = ', '.join([x for x in _EXPERIMENT_COLUMNS.keys() if
                             _EXPERIMENT_COLUMNS[x] is None])
        raise ValueError(f"Columns missing from {_EXP_SHEET} sheet: {missing}")
    # end if
    return title_row, first_col, last_col

def _main_func(args):
    """
    Parse the input arguments, download a GitHub repository's issues, and
    update an issues spreadsheet.
    """
    repository, spreadsheet, overwrite = parse_command_line(args)
    write_new_spreadsheet = True
    exp_align = openpyxl.styles.Alignment(horizontal="left")
    exp_font = openpyxl.styles.Font(size=str(_SHEET_FONT_SIZE), bold=False)
    exp_fills = [openpyxl.styles.fills.PatternFill(start_color="ffffff",
                                                   end_color="ffffff",
                                                   patternType="solid"),
                 openpyxl.styles.fills.PatternFill(start_color="dee6ef",
                                                   end_color="dee6ef",
                                                   patternType="solid")]


    wb_file = os.path.realpath(spreadsheet)
    if os.path.exists(wb_file) and (not overwrite):
        write_new_spreadsheet = False
        # Open and read the notebook
        workbook = openpyxl.load_workbook(wb_file)
        sheet_names = workbook.sheetnames
        if _EXP_SHEET not in sheet_names:
            raise ValueError(f"Sheet, {_EXP_SHEET} not found in {wb_file}.")
        # end if
        sheet = workbook[_EXP_SHEET]
        title_row, first_col, last_col = find_experiment_row(sheet)
        exp_font = sheet.cell(row=title_row+1, column=1).font
    else:
        workbook = openpyxl.Workbook()
        # Should only be on worksheet. Be sure
        while len(workbook.worksheets) > 1:
            workbook.remove_sheet(workbook.sheetnames[-1])
        # end while
        sheet = workbook.worksheets[0]
        title_row, first_col, last_col = initialize_experiment_sheet(sheet)
        exp_font = openpyxl.styles.Font(size=str(_SHEET_FONT_SIZE), bold=False)
    # end if

    # Download the issues
    repo_issues = download_github_issues(repository)

    ## Parse the issues and fill out one row per issue
    curr_row = title_row
    fill_index = 0
    for issue_num in sorted(repo_issues.keys()):
        issue = repo_issues[issue_num]
        # Find a row to write on
        if write_new_spreadsheet:
            curr_row += 1
        else:
            col = _EXPERIMENT_COLUMNS["Issue_id"]
            curr_row = find_row(sheet, str(issue_num), min_row=title_row+1,
                                min_col=col, max_col=col, blank_ok=True)
            if not curr_row:
                # Did not find row!
                raise Exception(f"No row available to write issue {issue_num}")
            # end if
        # end if
        for key in issue.keys():
            col = _EXPERIMENT_COLUMNS[key]
            if not col:
                raise Exception(f"Internal ERROR: No column found for {key}")
            # end if
            set_cell(sheet, curr_row, col, issue[key], alignment=exp_align,
                     fill=exp_fills[fill_index], font=exp_font)
        # end for
        fill_index = 1 - fill_index # Alternate rows
    # end for
    workbook.save(wb_file)
    return 0

###############################################################################

if __name__ == "__main__":
    ret = _main_func(sys.argv[1:])
    sys.exit(ret)
